# =====================================================================
# Zyra Environment Variables Template (.env.example)
# Copy this file to .env and configure values for your environment.
# =====================================================================

# ---------------------------------------------------------------------
# Environment Mode & Core Security
# ---------------------------------------------------------------------
# Set DJANGO_ENV to 'production' or 'development' (defaults to production if unset)
DJANGO_ENV=development

# DEBUG: Default is False in production; only set to True for local development
DEBUG=True

# Application Brand Name
APP_NAME=Zyra

# Django SECRET_KEY (REQUIRED in production; application crashes on startup if missing or insecure)
# Generate via: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY="your-super-secret-key-here-do-not-share"

# ---------------------------------------------------------------------
# Host & CSRF Configuration (Strict - NO '*' wildcard allowed)
# ---------------------------------------------------------------------
# Comma-separated list of valid hostnames/domains for this server
ALLOWED_HOSTS="localhost,127.0.0.1"

# Comma-separated list of trusted origins for CSRF POST requests
CSRF_TRUSTED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Local development: Leave unset to use SQLite automatically (db.sqlite3)
# Production PostgreSQL (Neon / Supabase / Railway / Render / AWS RDS):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------
# Real-Time WebSockets & Cache (Redis)
# ---------------------------------------------------------------------
# REQUIRED in production for Django Channels RedisChannelLayer and caching.
# In local development (DEBUG=True), can be left unset to use InMemoryChannelLayer and LocMemCache.
# REDIS_URL="redis://localhost:6379/0"

# ---------------------------------------------------------------------
# HTTPS & Security Headers (Production)
# ---------------------------------------------------------------------
# Redirect all HTTP requests to HTTPS in production
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS) duration in seconds (1 year default)
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------
# Object Storage (Choose S3/R2 OR Cloudinary)
# ---------------------------------------------------------------------
# Option A: AWS S3 or Cloudflare R2 (Recommended for Production)
USE_S3=False
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME=""
# For Cloudflare R2, set the S3 endpoint URL (e.g. https://<accountid>.r2.cloudflarestorage.com)
AWS_S3_ENDPOINT_URL=""
# Custom public CDN domain for R2/S3 (e.g. https://media.yourdomain.com)
AWS_S3_CUSTOM_DOMAIN=""
AWS_S3_REGION_NAME="auto"

# Option B: Cloudinary (Alternative Object Storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""
